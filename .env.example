# Web3Forms access key for the contact form (https://web3forms.com, free).
# Copy this file to .env.local and paste your key. On Netlify, add the same
# variable under Site configuration > Environment variables, then redeploy:
# NEXT_PUBLIC_ variables are inlined at build time.
NEXT_PUBLIC_WEB3FORMS_KEY=

# Optional: canonical site URL for SEO (Open Graph, sitemap, robots) when using a custom domain.
# Netlify builds fall back to the site's own URL automatically; local builds use localhost.
# NEXT_PUBLIC_SITE_URL=https://example.com
